# Touch Grass: server-side configuration for the AI coach.
#
# Copy this file to .env.local (never commit it: .env.local is git-ignored) and fill in ONE line.
# None of these variables is prefixed VITE_, so none of them ever reaches the browser.
# On Vercel, add the same names under Project > Settings > Environment Variables and redeploy.
# With no key at all the app still works: the built-in offline coach answers.

# --- Fastest path: one free key ----------------------------------------------------------------
# Get a free Groq key (no card, about two minutes): https://console.groq.com/keys
# The provider is detected from the key prefix (gsk_ = Groq, sk-or- = OpenRouter, AIza or AQ. = Gemini,
# nvapi- = NVIDIA, hf_ = Hugging Face, csk- = Cerebras, vck_ = Vercel AI Gateway).
AI_API_KEY=

# Only for a key with no recognisable prefix (Mistral, Cohere, SambaNova, Together): name its provider.
# AI_PROVIDER=mistral
# Replace the default model(s) for the key above, for example if a provider retires a model id.
# AI_MODEL=openai/gpt-oss-120b

# --- Several providers: they are tried in this order when one fails or is rate limited ----------
# GROQ_API_KEY=
# GEMINI_API_KEY=            https://aistudio.google.com/apikey (not for under-18 audiences or the EEA/UK/CH on the free tier)
# MISTRAL_API_KEY=           https://console.mistral.ai (free mode may train on your prompts unless you opt out)
# OPENROUTER_API_KEY=        https://openrouter.ai/keys (free models: about 50 requests a day)
# CLOUDFLARE_AI_TOKEN=       Workers AI token, needs the account id below
# CLOUDFLARE_AI_ACCOUNT_ID=
# SAMBANOVA_API_KEY=         free tier is about 20 requests a day
# NVIDIA_API_KEY=            development and testing only (NVIDIA's terms)
# COHERE_API_KEY=            trial key: development and testing only
# CEREBRAS_API_KEY=          no longer free
# HUGGINGFACE_API_KEY=       tiny free credit
# TOGETHER_API_KEY=          prepaid only
# AI_GATEWAY_API_KEY=        Vercel AI Gateway

# Comma-separated provider ids to try first, in this order (groq, gemini, mistral, openrouter, cloudflare,
# sambanova, nvidia, cohere, cerebras, huggingface, together, vercel, custom). The rest follow in the default order.
# AI_FALLBACK_ORDER=gemini,groq

# --- Any other OpenAI-compatible endpoint (including a local Ollama) -----------------------------
# https only; http is accepted for localhost and 127.0.0.1 so a local model works. Needs AI_MODEL.
# AI_BASE_URL=https://llm.example.com/v1
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=                (optional for a local model)
# AI_MODEL=llama3.2

# --- Safety and limits (all optional) ------------------------------------------------------------
# Extra origins allowed to call /api/*, comma-separated (the site's own origin is always allowed).
# There is no wildcard: "*" is ignored on purpose.
# ALLOWED_ORIGINS=https://www.example.com
# Requests per hour per visitor, best effort per server instance (default 30).
# AI_RATE_PER_HOUR=30
# Upstream calls allowed at once per server instance (default 8).
# AI_MAX_CONCURRENCY=8
# Longest reply in tokens (default 600, range 64 to 1500).
# AI_MAX_OUTPUT_TOKENS=600
